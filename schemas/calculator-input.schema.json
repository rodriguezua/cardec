{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardec.app/schemas/calculator-input.schema.json",
  "title": "Cardec calculator scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "name",
    "flow",
    "analysis",
    "modeling"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "scenarioId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceScenarioId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "flow": {
      "enum": [
        "replacement-timing",
        "new-car-acquisition",
        "used-vs-new"
      ]
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "modeling": {
      "$ref": "#/$defs/modeling"
    },
    "replacementTiming": {
      "$ref": "#/$defs/replacementTiming"
    },
    "newCarAcquisition": {
      "$ref": "#/$defs/newCarAcquisition"
    },
    "usedVsNew": {
      "$ref": "#/$defs/usedVsNew"
    }
  },
  "oneOf": [
    {
      "properties": {
        "flow": {
          "const": "replacement-timing"
        }
      },
      "required": [
        "replacementTiming"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "newCarAcquisition"
            ]
          },
          {
            "required": [
              "usedVsNew"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "flow": {
          "const": "new-car-acquisition"
        },
        "modeling": {
          "properties": {
            "mode": {
              "const": "deterministic"
            }
          }
        }
      },
      "required": [
        "newCarAcquisition"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "replacementTiming"
            ]
          },
          {
            "required": [
              "usedVsNew"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "flow": {
          "const": "used-vs-new"
        }
      },
      "required": [
        "usedVsNew"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "replacementTiming"
            ]
          },
          {
            "required": [
              "newCarAcquisition"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "money": {
      "type": "number",
      "minimum": 0
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asOfDate",
        "currency",
        "distanceUnit",
        "annualDistance",
        "horizonMonths",
        "taxJurisdiction",
        "rateBasis",
        "discountRate"
      ],
      "properties": {
        "asOfDate": {
          "type": "string",
          "format": "date"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "distanceUnit": {
          "enum": [
            "mile",
            "kilometer"
          ]
        },
        "annualDistance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "horizonMonths": {
          "type": "integer",
          "minimum": 12,
          "maximum": 360
        },
        "taxJurisdiction": {
          "type": "string",
          "minLength": 1,
          "description": "Jurisdiction identifier used to calculate editable tax and mandatory-fee estimates."
        },
        "rateBasis": {
          "enum": [
            "real",
            "nominal"
          ]
        },
        "discountRate": {
          "$ref": "#/$defs/rate"
        },
        "inflationRate": {
          "$ref": "#/$defs/rate"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rateBasis": {
                "const": "nominal"
              }
            },
            "required": [
              "rateBasis"
            ]
          },
          "then": {
            "required": [
              "inflationRate"
            ]
          },
          "else": {
            "not": {
              "required": [
                "inflationRate"
              ]
            }
          }
        }
      ]
    },
    "modeling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "deterministic",
            "stochastic"
          ]
        },
        "simulationRuns": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000
        },
        "randomSeed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "stochastic"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "simulationRuns"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "simulationRuns"
                  ]
                },
                {
                  "required": [
                    "randomSeed"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "vehicleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "modelYear",
        "currentMileage"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "modelYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "currentMileage": {
          "type": "number",
          "minimum": 0
        },
        "inServiceDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "vehicleOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price",
        "purchaseTax",
        "fees",
        "incentives"
      ],
      "properties": {
        "msrp": {
          "$ref": "#/$defs/money",
          "description": "Manufacturer suggested retail price used for lease residual percentages when available."
        },
        "price": {
          "$ref": "#/$defs/money"
        },
        "purchaseTax": {
          "$ref": "#/$defs/money",
          "description": "Calculated purchase tax or mandatory acquisition charge after jurisdiction-specific rates and caps."
        },
        "fees": {
          "$ref": "#/$defs/money"
        },
        "incentives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/incentive"
          }
        }
      }
    },
    "incentive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "amount",
        "source",
        "appliesTo"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "$ref": "#/$defs/money"
        },
        "source": {
          "enum": [
            "federal",
            "state",
            "local",
            "manufacturer",
            "dealer",
            "other"
          ]
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "cash",
              "loan",
              "lease"
            ]
          }
        }
      }
    },
    "yearValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "value"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "value": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "costSchedule": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/yearValue"
      }
    },
    "resaleForecast": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/yearValue"
      }
    },
    "operatingCosts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governmentCharges",
        "annualEnergy",
        "maintenance"
      ],
      "properties": {
        "annualInsurance": {
          "$ref": "#/$defs/money",
          "description": "Optional insurance cost. Omit when insurance is excluded from the comparison."
        },
        "governmentCharges": {
          "$ref": "#/$defs/costSchedule",
          "description": "Recurring registration, vehicle property tax, and mandatory vehicle surcharges by year."
        },
        "annualEnergy": {
          "$ref": "#/$defs/money"
        },
        "maintenance": {
          "$ref": "#/$defs/costSchedule"
        }
      }
    },
    "failureEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "year",
        "probability",
        "repairCost",
        "downtimeCost"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "probability": {
          "$ref": "#/$defs/rate"
        },
        "repairCost": {
          "$ref": "#/$defs/money"
        },
        "downtimeCost": {
          "$ref": "#/$defs/money"
        },
        "costStdDev": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "loan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "downPayment": {
          "$ref": "#/$defs/money"
        },
        "apr": {
          "$ref": "#/$defs/rate"
        },
        "termMonths": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "originationFees": {
          "$ref": "#/$defs/money",
          "default": 0,
          "description": "Advanced input that is zero for a typical consumer auto loan."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "downPayment",
              "apr",
              "termMonths",
              "originationFees"
            ]
          }
        }
      ]
    },
    "capitalOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "startingCapital": {
          "$ref": "#/$defs/money"
        },
        "expectedAnnualReturn": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "default": 0.1,
          "description": "Gross annual return compounded yearly; no investment sale or tax is modeled."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "startingCapital",
              "expectedAnnualReturn"
            ]
          }
        }
      ]
    },
    "replacementTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicle",
        "currentMarketValue",
        "loanPayoff",
        "resaleForecast",
        "operatingCosts",
        "failureEvents",
        "replacementOffer",
        "capitalOverlay"
      ],
      "properties": {
        "vehicle": {
          "$ref": "#/$defs/vehicleIdentity"
        },
        "currentMarketValue": {
          "$ref": "#/$defs/money"
        },
        "loanPayoff": {
          "$ref": "#/$defs/money"
        },
        "resaleForecast": {
          "$ref": "#/$defs/resaleForecast"
        },
        "operatingCosts": {
          "$ref": "#/$defs/operatingCosts"
        },
        "failureEvents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failureEvent"
          }
        },
        "replacementOffer": {
          "$ref": "#/$defs/vehicleOffer"
        },
        "replacementAnnualOperatingCost": {
          "$ref": "#/$defs/money"
        },
        "transactionCosts": {
          "$ref": "#/$defs/money"
        },
        "capitalOverlay": {
          "$ref": "#/$defs/capitalOverlay"
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "termMonths": {
          "type": "integer",
          "minimum": 1,
          "maximum": 72
        },
        "dueAtSigning": {
          "$ref": "#/$defs/money"
        },
        "capitalizedCostReduction": {
          "$ref": "#/$defs/money"
        },
        "upfrontTaxesAndFees": {
          "$ref": "#/$defs/money"
        },
        "firstPaymentIncludedInDueAtSigning": {
          "type": "boolean"
        },
        "monthlyPayment": {
          "$ref": "#/$defs/money"
        },
        "residualValue": {
          "$ref": "#/$defs/money"
        },
        "annualMileageAllowance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "excessMileageRate": {
          "$ref": "#/$defs/money"
        },
        "dispositionFee": {
          "$ref": "#/$defs/money"
        },
        "refundableDeposit": {
          "$ref": "#/$defs/money"
        },
        "termEndStrategy": {
          "enum": [
            "return",
            "buyout",
            "replacement-lease"
          ]
        },
        "earlyExitQuotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/monthValue"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "termMonths",
              "dueAtSigning",
              "capitalizedCostReduction",
              "upfrontTaxesAndFees",
              "firstPaymentIncludedInDueAtSigning",
              "monthlyPayment",
              "residualValue",
              "annualMileageAllowance",
              "excessMileageRate",
              "dispositionFee",
              "termEndStrategy"
            ]
          }
        }
      ]
    },
    "monthValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "value"
      ],
      "properties": {
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        },
        "value": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "newCarAcquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicle",
        "offer",
        "resaleForecast",
        "operatingCosts",
        "cashEnabled",
        "loan",
        "lease",
        "capitalOverlay"
      ],
      "properties": {
        "vehicle": {
          "$ref": "#/$defs/vehicleIdentity"
        },
        "offer": {
          "$ref": "#/$defs/vehicleOffer"
        },
        "resaleForecast": {
          "$ref": "#/$defs/resaleForecast"
        },
        "operatingCosts": {
          "$ref": "#/$defs/operatingCosts"
        },
        "cashEnabled": {
          "type": "boolean"
        },
        "loan": {
          "$ref": "#/$defs/loan"
        },
        "lease": {
          "$ref": "#/$defs/lease"
        },
        "capitalOverlay": {
          "$ref": "#/$defs/capitalOverlay"
        }
      }
    },
    "purchaseCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicle",
        "offer",
        "resaleForecast",
        "operatingCosts",
        "financing"
      ],
      "properties": {
        "vehicle": {
          "$ref": "#/$defs/vehicleIdentity"
        },
        "offer": {
          "$ref": "#/$defs/vehicleOffer"
        },
        "resaleForecast": {
          "$ref": "#/$defs/resaleForecast"
        },
        "operatingCosts": {
          "$ref": "#/$defs/operatingCosts"
        },
        "financing": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "cash"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "loan"
              ],
              "properties": {
                "type": {
                  "const": "loan"
                },
                "loan": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/loan"
                    },
                    {
                      "properties": {
                        "enabled": {
                          "const": true
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "usedVsNew": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used",
        "newBenchmark",
        "usedFailureEvents",
        "capitalOverlay"
      ],
      "properties": {
        "used": {
          "$ref": "#/$defs/purchaseCandidate"
        },
        "newBenchmark": {
          "$ref": "#/$defs/purchaseCandidate"
        },
        "inspectionAndReconditioning": {
          "$ref": "#/$defs/money"
        },
        "usedFailureEvents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failureEvent"
          }
        },
        "capitalOverlay": {
          "$ref": "#/$defs/capitalOverlay"
        }
      }
    }
  }
}
